{
  "appId": "com.hasanaa.app",
  "appName": "Hasana",
  "webDir": "www",
  "backgroundColor": "#125e54",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://hasanaa.com",
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": [
      "hasanaa.com",
      "*.hasanaa.com",
      "127.0.0.1",
      "localhost",
      "10.0.2.2"
    ]
  },
  "android": {
    "backgroundColor": "#125e54",
    "allowMixedContent": true
  },
  "ios": {
    "backgroundColor": "#125e54"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#125e54",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    }
  }
}
