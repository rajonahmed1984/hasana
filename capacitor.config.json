{
  "appId": "com.hasanaa.app",
  "appName": "Hasana",
  "webDir": "www",
  "backgroundColor": "#0d3b34",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://hasanaa.com",
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": [
      "hasanaa.com",
      "*.hasanaa.com",
      "127.0.0.1",
      "localhost",
      "10.0.2.2"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "backgroundColor": "#0d3b34",
    "allowMixedContent": true
  },
  "ios": {
    "backgroundColor": "#125e54"
  },
  "plugins": {
    "SystemBars": {
      "style": "DARK",
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#0d3b34",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_hasana",
      "iconColor": "#125E54"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
