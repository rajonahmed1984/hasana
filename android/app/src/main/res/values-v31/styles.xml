<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+ launch splash: same as values/styles.xml (plain background; MainActivity draws the full splash). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/hasana_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
