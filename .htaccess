<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Prevent rewrite loop if request is already inside /public/
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Handle storage files fallback to public/uploads/ if storage symlink is missing on cPanel
    RewriteCond %{REQUEST_URI} ^/storage/(.*)$ [NC]
    RewriteCond %{DOCUMENT_ROOT}/public/storage/$1 !-f
    RewriteCond %{DOCUMENT_ROOT}/public/uploads/$1 -f
    RewriteRule ^storage/(.*)$ public/uploads/$1 [L]

    # Rewrite all requests to public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
